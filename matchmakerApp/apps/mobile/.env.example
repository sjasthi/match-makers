# Base URL of the FP2 backend (Nginx API gateway).
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Which auth transport the app should use.
#   mock    -> local mock backend, no server required (default, great for UI work)
#   jwt     -> Authorization: Bearer <accessToken> + refresh token rotation
#   session -> HttpOnly cookie session, requests sent with credentials
EXPO_PUBLIC_AUTH_MODE=mock

# Set to "true" to let the mock backend fail ~5% of requests,
# useful for exercising loading and error states.
EXPO_PUBLIC_MOCK_LATENCY=450
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
