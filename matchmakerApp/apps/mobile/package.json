  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.11",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.2",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
