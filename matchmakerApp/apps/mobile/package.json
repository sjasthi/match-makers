{
  "name": "@match-makers/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "build": "expo export --platform web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
