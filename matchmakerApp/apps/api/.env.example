# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# `migrate` and the server both read the same variable, so the schema can never
# be applied to one database while the server talks to another -- which is the
# failure mode a hardcoded connection string invites.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/matchmakers

PORT=3001
NODE_ENV=development

# Salt and pepper for `src/password.ts`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both are optional. Without a pepper a stolen hash is enough to attack
# offline, which is the attack a database breach is actually for.
PASSWORD_PEPPER=

# Signs access tokens (`src/auth.ts`). Required in production; the development
# default only exists so `npm run dev` works without setup.
AUTH_SECRET=

# Origins allowed to call this API from a browser, comma-separated.
#
# Required only for the Expo **web** target: its dev server runs on 8081 and the
# API on 3001, and a browser refuses cross-origin requests that lack CORS
# headers. Native (iOS/Android) ignores this entirely.
#
# An allowlist rather than `*`, because `*` is illegal alongside credentials and
# would let any page in your browser call a local API holding real profiles.
# Add your port here if Expo picks a different one because 8081 is taken.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006